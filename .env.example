# Arkria Studio OS — server configuration.
# Copy to .env.local for local development, or set these as environment
# variables on your host. Nothing here is needed to try the app locally.

# --- Team access (REQUIRED for any shared deployment) -----------------------
# The team password. Everyone signs in with it at /login. In production the
# API refuses to run without it (set ARKRIA_ALLOW_OPEN=true to opt out, e.g.
# on a private network — not recommended).
ARKRIA_ADMIN_PASSWORD=

# --- Storage ------------------------------------------------------------------
# Leave these empty to store data in ./data/arkria.json on the server's disk
# (fine for a laptop, VPS or Docker with a volume).
# On Vercel / Netlify / other serverless hosts there is no persistent disk, so
# you MUST use Supabase: create a project at https://supabase.com, run
# supabase/schema.sql in its SQL editor, then paste these from
# Project Settings → API. Keep the service-role key secret (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ARKRIA_ALLOW_OPEN=true

# --- Lead Finder ----------------------------------------------------------------
# All optional. Keys are read on the server only and never sent to the browser.
#
# Business discovery. Without it Lead Finder shows "Lead provider not connected"
# (CSV import, manual add and the Website auditor still work).
# Google Cloud console → enable "Places API (New)" → Credentials → API key.
# Restrict the key to the Places API.
GOOGLE_PLACES_API_KEY=
# Adds Google's mobile PageSpeed score to website audits ("PageSpeed Insights API").
GOOGLE_PAGESPEED_API_KEY=
# Smarter search understanding + "Personalize with AI" outreach drafts.
# Without it, the built-in rule-based versions are used.
ANTHROPIC_API_KEY=
# Enables AUTO FIND on Vercel: the daily cron in vercel.json calls
# /api/lead-finder/auto with this secret. Any long random string.
CRON_SECRET=
