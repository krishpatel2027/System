# Arkria Studio OS — backend config (all optional for local demo)
#
# LOCAL FILE BACKEND (default): API routes persist to ./data/arkria.json. No setup needed.
#
# SUPABASE BACKEND (production): create a project at https://supabase.com,
# run supabase/schema.sql in the SQL editor, then set:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to the Supabase table prefix if you change it (default: public).
# SUPABASE_SCHEMA=public

# API AUTH (optional but recommended when deployed):
# When set, /api/store requires `Authorization: Bearer <token>`.
# Log in via /login with this password to store the token in the browser.
ARKRIA_ADMIN_PASSWORD=
